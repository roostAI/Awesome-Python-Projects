import unittest
from unittest.mock import patch, MagicMock
from Asteroids-RiceRocks import Ship, Sprite, angle_to_vector, missile_group, missile_image, missile_info, missile_sound

class Test_ShipShoot(unittest.TestCase):

    @patch('Asteroids-RiceRocks.missile_group', new_callable=set)
    def test_missile_creation_and_addition(self, mock_missile_group):
        # Arrange
        ship = Ship([100, 100], [1, 1], 0, None, None)  # TODO: Replace None with actual image and info
        self.assertEqual(len(mock_missile_group), 0)

        # Act
        ship.shoot()

        # Assert
        self.assertEqual(len(mock_missile_group), 1)
        missile = next(iter(mock_missile_group))
        self.assertEqual(missile.pos, [100 + 35 * 1, 100 + 35 * 0])  # Assuming radius is 35
        self.assertEqual(missile.vel, [1 + 6 * 1, 1 + 6 * 0])

    @patch('Asteroids-RiceRocks.missile_group', new_callable=set)
    def test_missile_position_calculation(self, mock_missile_group):
        # Arrange
        ship = Ship([200, 200], [0, 0], math.pi / 4, None, None)  # TODO: Replace None with actual image and info

        # Act
        ship.shoot()

        # Assert
        missile = next(iter(mock_missile_group))
        forward = angle_to_vector(math.pi / 4)
        expected_pos = [200 + 35 * forward[0], 200 + 35 * forward[1]]
        self.assertEqual(missile.pos, expected_pos)

    @patch('Asteroids-RiceRocks.missile_group', new_callable=set)
    def test_missile_velocity_calculation(self, mock_missile_group):
        # Arrange
        ship = Ship([0, 0], [2, 2], math.pi / 2, None, None)  # TODO: Replace None with actual image and info

        # Act
        ship.shoot()

        # Assert
        missile = next(iter(mock_missile_group))
        forward = angle_to_vector(math.pi / 2)
        expected_vel = [2 + 6 * forward[0], 2 + 6 * forward[1]]
        self.assertEqual(missile.vel, expected_vel)

    @patch('Asteroids-RiceRocks.missile_sound')
    def test_missile_sound_playback(self, mock_missile_sound):
        # Arrange
        ship = Ship([0, 0], [0, 0], 0, None, None)  # TODO: Replace None with actual image and info
        mock_missile_sound.play = MagicMock()

        # Act
        ship.shoot()

        # Assert
        mock_missile_sound.play.assert_called_once()

    @patch('Asteroids-RiceRocks.missile_group', new_callable=set)
    def test_multiple_missile_launches(self, mock_missile_group):
        # Arrange
        ship = Ship([0, 0], [0, 0], 0, None, None)  # TODO: Replace None with actual image and info

        # Act
        ship.shoot()
        ship.shoot()
        ship.shoot()

        # Assert
        self.assertEqual(len(mock_missile_group), 3)
        for missile in mock_missile_group:
            self.assertIsInstance(missile, Sprite)

if __name__ == '__main__':
    unittest.main()
